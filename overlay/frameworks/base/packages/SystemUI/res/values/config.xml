<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>

    <!-- Doze: does this device support STATE_DOZE?  -->
	<bool name="doze_display_state_supported">true</bool>

    <!-- For how long the lock screen can be on before the display turns off. -->
        <integer name="config_lockScreenDisplayTimeout">7000</integer>

    <string name="config_rounded_mask" translatable="false">M22,0C19.94,0.01 18.83,0.04 17.73,0.11C16.91,0.17 16.09,0.25 15.3,0.36C14.5,0.48 13.72,0.62 12.95,0.81C11.42,1.19 9.97,1.72 8.65,2.43C7.32,3.14 6.12,4.02 5.08,5.07C4.04,6.11 3.15,7.31 2.44,8.64C1.73,9.97 1.19,11.42 0.82,12.94C0.63,13.7 0.48,14.49 0.37,15.29C0.25,16.09 0.17,16.9 0.12,17.72C0.05,18.82 0.02,19.93 0.01,21.55</string>

    <!-- FPSInfoService Fps file path -->
    <string name="config_fpsInfoSysNode" translatable="false">/sys/devices/virtual/graphics/fb0/measured_fps</string>

</resources>

    <!-- Max visible notification icons -->
    <integer name="config_maxVisibleNotificationIcons">6</integer>
    <integer name="config_maxVisibleNotificationIconsWhenDark">7</integer>

    <!-- Show the network traffic monitor on statusbar even if the device has a notch -->
    <bool name="config_forceShowNetworkTrafficOnStatusBar">true</bool>

    <!-- Default no. of QS tile rows and columns -->
    <integer name="config_qs_columns_portrait">4</integer>
    <integer name="config_qs_rows_portrait">2</integer>
    <integer name="config_qs_columns_landscape">5</integer>
    <integer name="config_qs_rows_landscape">1</integer>

    <!-- Allow devices override audio panel location to the left side -->
    <bool name="config_audioPanelOnLeftSide">false</bool>

    <!-- The CPU temperature sensor path, defaults to empty -->
    <string name="config_cpuTempSensor" translatable="true">/sys/class/thermal/thermal_zone0/temp</string>

    <!-- The CPU temperature divider, if needed -->
    <integer name="config_cpuTempDivider" translatable="true">1</integer>

    <!-- The CPUs to display in CPUInfoService view -->
    <string name="config_displayCpus" translatable="true"></string>

    <!-- FPSInfoService FPS node file path -->
    <string name="config_fpsInfoSysNode" translatable="false"></string>

    <!-- Whether to use the mask for the quicksettings icons-->
    <bool name="config_useMaskForQs">true</bool>

    <!-- Config to enable/disable qs tile tinting -->
    <bool name="config_enable_qs_tile_tinting">true</bool>
    
    <!-- Whether to disable assist hint on lockscreen -->
    <bool name="config_disableAssistHintOnLockscreen">false</bool>

    <!-- Burn in protection -->
    <bool name="config_statusBarBurnInProtection">true</bool>
    <integer name="config_shift_interval">60</integer>

    <!-- On-The-Go -->
    <integer name="quick_settings_onthego_dialog_short_timeout">3000</integer>
    <integer name="quick_settings_onthego_dialog_long_timeout">6000</integer>

    <!-- FPS measure interval in milliseconds, default 1000 -->
    <integer name="config_fpsReadInterval">1000</integer>
</resources>
